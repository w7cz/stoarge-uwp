<Page x:Class="XboxStorageAnalyzer.MainPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#0E1116">
  <Page.Resources>
    <SolidColorBrush x:Key="XGreen" Color="#107C10"/>
    <DataTemplate x:Key="RowT">
      <Grid Margin="0,6" MinHeight="56">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="170"/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="{Binding Name}" FontSize="22" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Note}" FontSize="14" Opacity=".6" TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap"/></StackPanel>
        <TextBlock Grid.Column="1" Text="{Binding Kind}" FontSize="16" Opacity=".7" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,0"/>
        <ProgressBar Grid.Column="3" Value="{Binding Percent}" Maximum="100" Foreground="{StaticResource XGreen}" VerticalAlignment="Center"/>
      </Grid>
    </DataTemplate>
    <Style TargetType="Button"><Setter Property="Margin" Value="0,0,12,0"/><Setter Property="FontSize" Value="20"/><Setter Property="UseSystemFocusVisuals" Value="True"/></Style>
  </Page.Resources>
  <Grid Margin="48,32">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="STORAGE ANALYZER  ·  Xbox Dev Mode" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource XGreen}"/>
    <Pivot x:Name="Tabs" Grid.Row="1" Margin="0,12,0,0" FontSize="20">
      <PivotItem Header="Dashboard">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <StackPanel>
            <TextBlock x:Name="VolText" FontSize="26"/>
            <ProgressBar x:Name="VolBar" Height="22" Maximum="100" Foreground="{StaticResource XGreen}" Margin="0,8"/>
            <TextBlock x:Name="VolSrc" FontSize="14" Opacity=".6" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Margin="0,12"><Button x:Name="RefreshBtn" Content="Refresh / Rescan" Click="Refresh_Click"/><Button Content="Cancel" Click="Cancel_Click"/></StackPanel>
          </StackPanel>
          <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="Largest directories (app-accessible)" FontSize="22"/><ListView x:Name="TopDirs" ItemTemplate="{StaticResource RowT}" SelectionMode="None"/></StackPanel>
            <StackPanel Grid.Column="1" Margin="24,0,0,0"><TextBlock Text="Largest files (app-accessible)" FontSize="22"/><ListView x:Name="TopFiles" ItemTemplate="{StaticResource RowT}" SelectionMode="None"/></StackPanel>
          </Grid></Grid>
      </PivotItem>
      <PivotItem Header="Explorer">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal"><Button Content="◀ Up" Click="Up_Click"/><Button Content="Scan sizes here" Click="ScanHere_Click"/><Button Content="Add folder…" Click="AddFolder_Click"/>
            <ComboBox x:Name="SortBox" SelectedIndex="0" Width="200" SelectionChanged="Sort_Changed" FontSize="20"><ComboBoxItem Content="Size"/><ComboBoxItem Content="Name"/><ComboBoxItem Content="Date modified"/></ComboBox></StackPanel>
          <TextBlock Grid.Row="1" x:Name="PathText" FontSize="16" Opacity=".7" Margin="0,8" TextWrapping="Wrap"/>
          <ListView Grid.Row="2" x:Name="Items" ItemTemplate="{StaticResource RowT}" IsItemClickEnabled="True" ItemClick="Items_Click"/>
        </Grid>
      </PivotItem>
      <PivotItem Header="Apps">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Button Content="Discover apps" Click="Apps_Click"/><TextBlock Grid.Row="1" x:Name="AppNote" FontSize="14" Opacity=".7" TextWrapping="Wrap" Margin="0,8"/>
          <ListView Grid.Row="2" x:Name="AppList" ItemTemplate="{StaticResource RowT}" SelectionMode="None"/></Grid>
      </PivotItem>
      <PivotItem Header="USB / Roots">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal"><Button Content="Detect USB" Click="Usb_Click"/><Button Content="Pick folder / drive…" Click="AddFolder_Click"/><Button Content="Probe drives &amp; DevelopmentFiles" Click="Probe_Click"/></StackPanel>
          <ListView Grid.Row="1" x:Name="RootList" ItemTemplate="{StaticResource RowT}" IsItemClickEnabled="True" ItemClick="Root_Click" Margin="0,8"/></Grid>
      </PivotItem>
    </Pivot>
    <StackPanel Grid.Row="2" Orientation="Horizontal"><ProgressRing x:Name="Ring" Width="28" Height="28" Margin="0,0,12,0"/><TextBlock x:Name="Status" FontSize="16" VerticalAlignment="Center" TextWrapping="Wrap"/></StackPanel>
  </Grid>
</Page>
